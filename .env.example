# Copy this file to .env and fill values for local development
# Never commit real secrets

# App environment
ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Live Scores API (optional)
# Get a free key from https://www.football-data.org/ or https://www.api-football.com/
FOOTBALL_API_KEY=your_key_here

# Monetization contest tuning (optional)
MAX_LEADERBOARD_ENTRIES=10
POINTS_BASE=50
POINTS_ML_BONUS=30

# Streamlit secrets (for cloud)
# Create .streamlit/secrets.toml for production secrets instead of .env
